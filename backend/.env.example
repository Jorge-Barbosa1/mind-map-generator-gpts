# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Comma-separated list of allowed frontend origins (CORS).
# Example: http://localhost:3000,https://myapp.example.com
# Render frontend for this repo:
FRONTEND_ORIGINS=http://localhost:3000,https://mind-map-generator-gpts-frontend.onrender.com

# Limits for uploaded content
MAX_FILE_SIZE_MB=20
MAX_PROMPT_CHARS=10000

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=60
